{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeeBoard",
  "version": "0.2.0",
  "identifier": "com.zeeboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeeBoard",
        "width": 1200,
        "height": 760,
        "minWidth": 1050,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AverageZebraBoy",
    "category": "Productivity",
    "shortDescription": "Commission manager for artists",
    "longDescription": "ZeeBoard keeps your art commissions organized: clients, characters, stages, payments and deadlines, all stored locally.",
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
